graph TD
    subgraph Roles
        User((User / PM))
        DevAgent{"DEV Agent (Codex)"}
        QAAgent{"QA Agent (150 IQ Zero-Trust)"}
    end

    subgraph Project Workspace
        Codebase[AutoTest Codebase<br/>studio/, core/, etc.]
        ChangesMD[changes.md<br/>Changelog & Fixes]
        DefectMD[defect.md<br/>Defect Tracker]
        SIT_UAT_Env[Local Port :3000<br/>SIT/UAT Environment]
    end

    %% User Interactions
    User -->|Directs feature development & fixes| DevAgent
    User -->|Commands zero-trust audits| QAAgent

    %% Dev Agent Workflow
    DevAgent -->|Builds & Patches| Codebase
    DevAgent -->|Documents applied changes| ChangesMD
    DevAgent -.->|Reads for next fixes| DefectMD

    %% QA Agent Workflow
    QAAgent -->|Monitors for new patches| ChangesMD
    QAAgent -->|Performs Static Analysis| Codebase
    QAAgent -->|Executes Dynamic Audits & UI Testing| SIT_UAT_Env
    QAAgent -->|Logs discovered vulnerabilities & bugs| DefectMD

    %% Styling
    classDef human fill:#d1c4e9,stroke:#388e3c,stroke-width:2px;
    classDef agent fill:#ffecb3,stroke:#512da8,stroke-width:2px;
    classDef artifact fill:#e3f2fd,stroke:#1976d2,stroke-width:1px;
    classDef env fill:#ffcdd2,stroke:#d32f2f,stroke-width:1px;

    class User human;
    class DevAgent,QAAgent agent;
    class Codebase,ChangesMD,DefectMD artifact;
    class SIT_UAT_Env env;
