graph TD
    %% Global Styles & Classes
    classDef supervisor fill:#0D5CAB,stroke:#014C8B,color:#fff,stroke-width:4px;
    classDef pm fill:#ffa500,stroke:#f57f17,color:#000,font-weight:bold;
    classDef dev fill:#2979FF,stroke:#fff,stroke-width:1px,color:#fff;
    classDef qa fill:#FF1744,stroke:#fff,stroke-width:2px,color:#fff;
    classDef infra fill:#121212,stroke:#333,stroke-width:1px,color:#888,stroke-dasharray: 5 5;
    classDef data fill:#f5f5f5,stroke:#ddd,color:#333;
    classDef engine fill:#00E676,stroke:#000,stroke-width:1px,color:#000;

    %% 1. ORCHESTRATION LAYER (Control Plane)
    subgraph Control_Plane ["fa:fa-user-tie COMMAND & CONTROL"]
        PM["ELITE PM ORCHESTRATOR<br/>(Zero-Defect Mandate)"]:::pm
        UI_SPA["STUDIO UI (SPA)<br/>Montserrat/OpenSans DNA"]:::supervisor
        SELECTOR["PLATFORM SELECTOR<br/>(Dynamic Toggle)"]:::dev
        UI_SPA --- SELECTOR
    end

    %% 2. INGESTION & PARSING (Track 1)
    subgraph Ingestion_Layer ["fa:fa-file-excel BLUEPRINT INGESTION"]
        direction TB
        EXCEL["DPR TEMPLATE.xlsx"]:::data
        PARSER["SCENARIO PARSER<br/>(Dynamic Header Detection)"]:::engine
        BLUEPRINT["BLUEPRINT JSON<br/>(Hierarchical Data)"]:::data
        
        EXCEL -->|"Upload"| PARSER
        PARSER --> BLUEPRINT
    end

    %% 3. MAPPING & AST ANALYSIS (Track 2)
    subgraph Mapping_Core ["fa:fa-code ACTION MAPPING ENGINE"]
        direction LR
        REC_WEB["PLAYWRIGHT RECORDER<br/>(Web Context)"]:::dev
        REC_MOB["APPIUM INSPECTOR<br/>(Mobile Stub)"]:::dev
        AST["AST PARSER (ACORN)<br/>Boilerplate Stripper"]:::engine
        MAPPINGS["MAPPINGS.JSON<br/>(Unique Action Store)"]:::data
        
        REC_WEB & REC_MOB -->|"Raw Code"| AST
        AST --> MAPPINGS
    end

    %% 4. DDT & STABILITY (Track 3 / 6)
    subgraph Stabilization_Layer ["fa:fa-shield-alt DATA & STABILITY"]
        MATRIX["DATA MATRIX UI<br/>(localStorage Persistent)"]:::dev
        RUNTIME["RUNTIME_DATA.JSON<br/>(Override Store)"]:::data
        SYNC["STABILITY INJECTOR<br/>(Navigation Awareness)"]:::engine
        
        MATRIX --> RUNTIME
        RUNTIME & SYNC --- COMPILER
    end

    %% 5. COMPILER & ROUTER (Track 4 / 5)
    subgraph Compiler_Core ["fa:fa-microchip EXECUTION ROUTER"]
        direction TB
        COMPILER["CORE COMPILER<br/>(Parallel Loop Gen)"]:::engine
        TRANSLATOR["LOCATOR TRANSLATOR<br/>(PW -> Mobile XPath)"]:::engine
        
        COMPILER -->|"Web Branch"| PW_TEST["PLAYWRIGHT WORKERS<br/>(Chromium Native)"]:::dev
        COMPILER -->|"Mobile Branch"| WDIO_TEST["WEBDRIVERIO WORKERS<br/>(Appium Remote)"]:::dev
        TRANSLATOR -.-> WDIO_TEST
    end

    %% 6. VALIDATION & DELIVERY (Certification)
    subgraph Validation_Gates ["fa:fa-certificate FINAL CERTIFICATION"]
        direction TB
        RESULTS["RESULTS DASHBOARD<br/>(Pass/Fail Chips)"]:::supervisor
        ARTIFACTS["HIGH-FIDELITY ARTIFACTS<br/>(800ms Rendered PNGs)"]:::data
        UAT["100-SCENARIO UAT<br/>(Zero-Defect Stress Test)"]:::qa
        
        PW_TEST & WDIO_TEST --> ARTIFACTS
        ARTIFACTS --> RESULTS
        RESULTS --> UAT
        UAT ==>|"KPI CERTIFIED"| RELEASE("PRODUCTION MASTER"):::pm
    end

    %% WORKFLOW FLOWS
    PM ==> Control_Plane
    Control_Plane ==> Ingestion_Layer
    Ingestion_Layer ==> Mapping_Core
    Mapping_Core ==> Stabilization_Layer
    Stabilization_Layer ==> Compiler_Core
    Compiler_Core ==> Validation_Gates

    %% MANDATES
    Note1["fa:fa-soul SOUL MANDATE:<br/>1. MINIMAL CHANGES TO WORKING CODE<br/>2. 100% DPR TEMPLATE COMPLIANCE<br/>3. ZERO WHITE PNG ARTIFACTS"]
    Note1 --- PM