graph TD
    %% Global Styles & Classes
    classDef supervisor fill:#0D5CAB,stroke:#014C8B,color:#fff,stroke-width:4px;
    classDef pm fill:#ffa500,stroke:#f57f17,color:#000,font-weight:bold;
    classDef dev fill:#2979FF,stroke:#fff,stroke-width:1px,color:#fff;
    classDef qa fill:#FF1744,stroke:#fff,stroke-width:2px,color:#fff;
    classDef infra fill:#121212,stroke:#333,stroke-width:1px,color:#888,stroke-dasharray: 5 5;
    classDef data fill:#f5f5f5,stroke:#ddd,color:#333;
    classDef engine fill:#00E676,stroke:#000,stroke-width:1px,color:#000;

    %% 1. ORCHESTRATION LAYER (Control Plane)
    subgraph Control_Plane ["fa:fa-user-tie COMMAND & CONTROL"]
        UI_SPA["STUDIO UI (SPA)<br/>Montserrat/OpenSans DNA"]:::supervisor
        RESET_SYS["RESET SYSTEM (Top-Right)<br/>Synchronous Wiping API"]:::qa
        PLATFORM["PLATFORM TOGGLE<br/>(Web vs Mobile)"]:::dev
        EXEC_OPTS["EXECUTION CONFIGS<br/>(Headless, Workers, Cancel)"]:::dev
        
        UI_SPA --- RESET_SYS
        UI_SPA --- PLATFORM
        UI_SPA --- EXEC_OPTS
    end

    %% 2. INGESTION & PARSING (Excel Ingestion)
    subgraph Ingestion_Layer ["fa:fa-file-excel BLUEPRINT INGESTION"]
        direction TB
        EXCEL["scenario_uploaded.xlsx<br/>(Excel Matrix Ingest)"]:::data
        PARSER["SCENARIO PARSER<br/>(scenario_parser.js)"]:::engine
        BLUEPRINT["blueprint.json<br/>(Hierarchical Blueprint)"]:::data
        
        EXCEL -->|"Upload"| PARSER
        PARSER --> BLUEPRINT
    end

    %% 3. MAPPING & AST ANALYSIS (Playwright Codegen)
    subgraph Mapping_Core ["fa:fa-code ACTION MAPPING ENGINE"]
        direction LR
        REPLAY_GEN["REPLAY GENERATOR<br/>(preceding replay_*.spec.ts)"]:::engine
        REC_SESSION["PLAYWRIGHT CODEGEN<br/>(Isolated Browser & Pause)"]:::dev
        AST["AST PARSER (ACORN)<br/>Locator/Command Extractor"]:::engine
        MAPPINGS["mappings.json<br/>(Mapping Library Store)"]:::data
        
        REPLAY_GEN --> REC_SESSION
        REC_SESSION -->|"Raw Playwright Code"| AST
        AST --> MAPPINGS
    end

    %% 4. DDT OVERRIDES (Data Matrix accordion)
    subgraph Stabilization_Layer ["fa:fa-shield-alt DDT OVERRIDE LAYER"]
        direction TB
        MATRIX["DATA MATRIX UI<br/>(Variable Harvesting)"]:::dev
        RUNTIME["runtime_data.json<br/>(DDT Row Iterations)"]:::data
        
        MATRIX --> RUNTIME
    end

    %% 5. COMPILER & RUNNER (Stitching execution spec)
    subgraph Compiler_Core ["fa:fa-microchip COMPILATION & RUNTIME"]
        direction TB
        COMPILER["CORE COMPILER<br/>(compiler.js)"]:::engine
        HIGHLIGHT["RED OUTLINE MARKER<br/>(markLocator Highlight)"]:::engine
        EXEC_SPEC["executed.spec.ts<br/>(Parameterized Loops)"]:::data
        
        BLUEPRINT & MAPPINGS & RUNTIME --> COMPILER
        COMPILER --> HIGHLIGHT
        HIGHLIGHT --> EXEC_SPEC
    end

    %% 6. EXECUTION & RESULTS (Server execution & directory listing)
    subgraph Execution_Layer ["fa:fa-play BACKGROUND RUNNER"]
        direction TB
        PW_CLI["PLAYWRIGHT CLI<br/>(Local DRIVERS/ Executable)"]:::engine
        STATUS["STATUS ROUTE<br/>(/run-status & /run-cancel)"]:::dev
        REPORT["report.json<br/>(Execution Metrics)"]:::data
        
        EXEC_SPEC --> PW_CLI
        PW_CLI --> STATUS
        PW_CLI --> REPORT
    end

    %% 7. AUDIT & STATIC SERVING (Results view & evidence)
    subgraph Audit_Gates ["fa:fa-certificate RESULTS & EVIDENCE AUDIT"]
        direction TB
        STATIC_SERV["STATIC FILES SERV<br/>(results/ directory route)"]:::engine
        CUSTOM_INDEX["CUSTOM DIR INDEX<br/>(results/ directory page)"]:::supervisor
        UAT_EVIDENCE["HIGH-FIDELITY ARTIFACTS<br/>(FINAL.png & trace.zip)"]:::data
        verification["21-SCENARIO VERIFICATION<br/>(hitl_scenario_test.js)"]:::qa
        
        REPORT --> STATIC_SERV
        STATIC_SERV --> CUSTOM_INDEX
        CUSTOM_INDEX --> UAT_EVIDENCE
        UAT_EVIDENCE --> verification
    end

    %% WORKFLOW FLOWS
    Control_Plane ==> Ingestion_Layer
    Ingestion_Layer ==> Mapping_Core
    Mapping_Core ==> Stabilization_Layer
    Stabilization_Layer ==> Compiler_Core
    Compiler_Core ==> Execution_Layer
    Execution_Layer ==> Audit_Gates

    %% SOUL MANDATES
    Note1["fa:fa-soul SYSTEM PREREQUISITES:<br/>1. Resilient page.goto (no networkidle hangs)<br/>2. Zero-install hybrid dependencies fallback<br/>3. Precise regex-based scenario ID cleaning"]
    Note1 --- UI_SPA