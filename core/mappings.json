{
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "goto",
        "target": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Password' })"
      },
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Password' })"
      },
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Username' })"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Username' })",
        "value": "Admin"
      }
    ]
  },
  "Input Password": {
    "steps": [
      {
        "type": "fill",
        "target": "input[name='password']",
        "value": "{{password}}"
      }
    ]
  },
  "Click Login Button": {
    "steps": [
      {
        "type": "click",
        "target": "button[type='submit']"
      }
    ]
  },
  "Verify Dashboard Header": {
    "steps": [
      {
        "type": "verifyVisible",
        "target": "h6:has-text('Dashboard')"
      }
    ]
  },
  "Verify Login Error Message": {
    "steps": [
      {
        "type": "verifyVisible",
        "target": "p.oxd-alert-content-text"
      }
    ]
  },
  "Click Admin Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text('Admin')"
      }
    ]
  },
  "Verify Admin Header": {
    "steps": [
      {
        "type": "verifyVisible",
        "target": "h6:has-text('Admin')"
      }
    ]
  },
  "Click PIM Menu": {
