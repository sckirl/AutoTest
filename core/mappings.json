{
  "Navigate to Studio": {
    "steps": [
      {
        "type": "goto",
        "target": "http://localhost:3000"
      }
    ]
  },
  "Upload Valid Excel": {
    "steps": [
      {
        "type": "upload",
        "target": "input#file-input",
        "value": "scenario.xlsx"
      }
    ]
  },
  "Click Record Button": {
    "steps": [
      {
        "type": "click",
        "target": "button.btn-record"
      }
    ]
  },
  "Perform Direct Action": {
    "steps": [
      {
        "type": "click",
        "target": "body"
      }
    ]
  },
  "Click Execute Scenarios": {
    "steps": [
      {
        "type": "click",
        "target": "button#run-btn"
      }
    ]
  },
  "Upload Invalid File": {
    "steps": [
      {
        "type": "upload",
        "target": "input#file-input",
        "value": "image.png"
      }
    ]
  },
  "Upload Empty Excel": {
    "steps": [
      {
        "type": "upload",
        "target": "input#file-input",
        "value": "empty.xlsx"
      }
    ]
  },
  "Upload Large Excel": {
    "steps": [
      {
        "type": "upload",
        "target": "input#file-input",
        "value": "large.xlsx"
      }
    ]
  },
  "Input Base URL": {
    "steps": [
      {
        "type": "fill",
        "target": "input#base-url",
        "value": "{{url}}"
      }
    ]
  },
  "Click Reset System": {
    "steps": [
      {
        "type": "click",
        "target": "button:has-text('Reset System')"
      }
    ]
  },
  "Run Tokenized Step": {
    "steps": [
      {
        "type": "fill",
        "target": "input#base-url",
        "value": "{{user}}"
      }
    ]
  },
  "Click Re-Map Button": {
    "steps": [
      {
        "type": "click",
        "target": "button.btn-record"
      }
    ]
  },
  "Paste Malicious Script": {
    "steps": [
      {
        "type": "fill",
        "target": "body",
        "value": "{{code}}"
      }
    ]
  },
  "Upload Special Char Excel": {
    "steps": [
      {
        "type": "upload",
        "target": "input#file-input",
        "value": "special_char.xlsx"
      }
    ]
  },
