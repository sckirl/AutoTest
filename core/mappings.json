{
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "goto",
        "target": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole(\"textbox\", \"name\")"
      },
      {
        "type": "fill",
        "target": "getByRole(\"textbox\", \"name\")",
        "value": "{user}"
      }
    ]
  },
  "Input Password": {
    "steps": [
      {
        "type": "fill",
        "target": "getByPlaceholder('Password')",
        "value": "{password}"
      }
    ]
  },
  "Click Login Button": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('button', { name: 'Login' })"
      }
    ]
  },
  "Click My Info Tab": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('link', { name: 'My Info' })"
      }
    ]
  },
  "Verify Personal Details Header": {
    "steps": [
      {
        "type": "assertVisible",
        "target": "getByRole('heading', { name: 'Personal Details' })"
      }
    ]
  },
  "Verify Login Error Message": {
    "steps": [
      {
        "type": "assertVisible",
        "target": "getByText('Invalid credentials')"
      }
    ]
  }
}