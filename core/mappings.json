    "steps": [
      {
        "type": "upload",
        "target": "input#file-input",
        "value": "autotest_self_scenario.xlsx"
      }
    ]
  },
  "Run JSON Data Step": {
    "steps": [
      {
        "type": "fill",
        "target": "input#base-url",
        "value": "{{data}}"
      }
    ]
  },
  "Trigger Studio Error": {
    "steps": [
      {
        "type": "upload",
        "target": "input#file-input",
        "value": "image.png"
      }
    ]
  },
  "Run Any Scenario": {
    "steps": [
      {
        "type": "goto",
        "target": "http://localhost:3000"
      }
    ]
