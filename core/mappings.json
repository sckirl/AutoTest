{
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "goto",
        "target": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "fill",
        "target": "input[name=\"username\"]",
        "value": "{{username}}"
      }
    ]
  },
  "Input Password": {
    "steps": [
      {
        "type": "fill",
        "target": "input[name=\"password\"]",
        "value": "{{password}}"
      }
    ]
  },
  "Click Login Button": {
    "steps": [
      {
        "type": "click",
        "target": "button[type=\"submit\"]"
      }
    ]
  },
  "Verify Dashboard Header": {
    "steps": [
      {
        "type": "assertVisible",
        "target": "h6.oxd-topbar-header-breadcrumb-module"
      }
    ]
  },
  "Verify Login Error Message": {
    "steps": [
      {
        "type": "assertVisible",
        "target": ".oxd-alert--error"
      }
    ]
  },
  "Click User Dropdown": {
    "steps": [
      {
        "type": "click",
        "target": "span.oxd-userdropdown-tab"
      }
    ]
  },
  "Click Logout": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-userdropdown-link:has-text(\"Logout\")"
      }
    ]
  },
  "Click Admin Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"Admin\")"
      }
    ]
  },
  "Verify Admin Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "Admin"
      }
    ]
  },
  "Click PIM Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"PIM\")"
      }
    ]
  },
  "Verify PIM Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "PIM"
      }
    ]
  },
  "Click Leave Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"Leave\")"
      }
    ]
  },
  "Verify Leave Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "Leave"
      }
    ]
  },
  "Click Time Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"Time\")"
      }
    ]
  },
  "Verify Time Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "Time"
      }
    ]
  },
  "Click Recruitment Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"Recruitment\")"
      }
    ]
  },
  "Verify Recruitment Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "Recruitment"
      }
    ]
  },
  "Click My Info Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"My Info\")"
      }
    ]
  },
  "Verify My Info Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "PIM"
      }
    ]
  },
  "Click Performance Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"Performance\")"
      }
    ]
  },
  "Verify Performance Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "Performance"
      }
    ]
  },
  "Click Dashboard Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"Dashboard\")"
      }
    ]
  },
  "Click Directory Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"Directory\")"
      }
    ]
  },
  "Verify Directory Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "Directory"
      }
    ]
  },
  "Click Maintenance Menu": {
    "steps": [
      {
        "type": "click",
        "target": "a.oxd-main-menu-item:has-text(\"Maintenance\")"
      }
    ]
  },
  "Verify Maintenance Header": {
    "steps": [
      {
        "type": "assertText",
        "target": "h6.oxd-topbar-header-breadcrumb-module",
        "value": "Maintenance"
      }
    ]
  },
  "Click Add Employee Tab": {
    "steps": [
      {
        "type": "click",
        "target": "li.oxd-topbar-body-nav-tab:has-text(\"Add Employee\")"
      }
    ]
  },
  "Input First Name": {
    "steps": [
      {
        "type": "fill",
        "target": "input[name=\"firstName\"]",
        "value": "{{fname}}"
      }
    ]
  },
  "Input Last Name": {
    "steps": [
      {
        "type": "fill",
        "target": "input[name=\"lastName\"]",
        "value": "{{lname}}"
      }
    ]
  },
  "Click Save Button": {
    "steps": [
      {
        "type": "click",
        "target": "button[type=\"submit\"]"
      }
    ]
  },
  "Input Employee Name Search": {
    "steps": [
      {
        "type": "fill",
        "target": "div.oxd-input-group:has(label:has-text(\"Employee Name\")) input",
        "value": "{{search}}"
      }
    ]
  },
  "Click Search Button": {
    "steps": [
      {
        "type": "click",
        "target": "button[type=\"submit\"]"
      }
    ]
  },
  "Click Review Performance Section": {
    "steps": [
      {
        "type": "click",
        "target": "a.orangehrm-tabs-item:has-text(\"Performance\")"
      }
    ]
  },
  "Click Update Contact Details Section": {
    "steps": [
      {
        "type": "click",
        "target": "a.orangehrm-tabs-item:has-text(\"Contact Details\")"
      }
    ]
  },
  "Click View Job Info Section": {
    "steps": [
      {
        "type": "click",
        "target": "a.orangehrm-tabs-item:has-text(\"Job\")"
      }
    ]
  },
  "Click Check Salary Details Section": {
    "steps": [
      {
        "type": "click",
        "target": "a.orangehrm-tabs-item:has-text(\"Salary\")"
      }
    ]
  },
  "Click Emergency Contacts Section": {
    "steps": [
      {
        "type": "click",
        "target": "a.orangehrm-tabs-item:has-text(\"Emergency Contacts\")"
      }
    ]
  },
  "Verify Content Visibility": {
    "steps": [
      {
        "type": "assertVisible",
        "target": ".orangehrm-edit-employee-content"
      }
    ]
  }
}
