{
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "goto",
        "target": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "fill",
        "target": "getByPlaceholder('Username')",
        "value": "{username}"
      }
    ]
  },
  "Input Password": {
    "steps": [
      {
        "type": "fill",
        "target": "getByPlaceholder('Password')",
        "value": "{password}"
      }
    ]
  },
  "Submit Login": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('button', { name: 'Login' })"
      }
    ]
  },
  "Verify Dashboard": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('heading', { name: 'Dashboard' })"
      }
    ]
  },
  "Verify Invalid Credentials Error": {
    "steps": [
      {
        "type": "toBeVisible",
        "target": "getByText('Invalid credentials')"
      }
    ]
  },
  "Verify Required Validation": {
    "steps": [
      {
        "type": "toBeVisible",
        "target": "locator('form').filter({ hasText: 'Required' })"
      }
    ]
  }
}