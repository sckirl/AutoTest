{
  "Navigate to PracticeTest": {
    "steps": [
      {
        "type": "goto",
        "target": "https://practicetestautomation.com/practice-test-login/"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Username' })"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Username' })",
        "value": "{username}"
      }
    ]
  }
}