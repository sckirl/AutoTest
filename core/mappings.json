{
  "Navigate to Practice Site": {
    "steps": [
      {
        "type": "goto",
        "target": "https://practicetestautomation.com/practice-test-login/"
      }
    ]
  },
  "Input Demo Username": {
    "steps": [
      {
        "type": "fill",
        "target": "getByLabel(\"Username\")",
        "value": "{Username}"
      }
    ]
  },
  "Input Demo Password": {
    "steps": [
      {
        "type": "fill",
        "target": "getByLabel(\"Password\")",
        "value": "{Password}"
      }
    ]
  },
  "Submit Login": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole(\"button\", \"name\")"
      }
    ]
  },
  "Verify Success Message": {
    "steps": []
  }
}