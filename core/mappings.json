    "steps": [
      {
        "type": "click",
        "target": "#drop-zone"
      }
    ]
  },
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "click",
        "target": "div"
      }
    ]
  },
  "Navigate to YouTube": {
    "steps": [
      {
        "type": "click",
        "target": "div"
      }
    ]
  }
}