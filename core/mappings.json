{
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "goto",
        "target": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Username' })"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Username' })",
        "value": "{}"
      },
      {
        "type": "press",
        "target": "getByRole('textbox', { name: 'Username' })",
        "value": "ArrowLeft"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Username' })",
        "value": "{Username}"
      }
    ]
  },
  "Input Password": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Password' })"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Password' })",
        "value": "admin123"
      }
    ]
  },
  "Click Login Button": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('button', { name: 'Login' })"
      }
    ]
  },
  "Click My Info Tab": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Type for hints...' })"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Type for hints...' })",
        "value": "{}"
      },
      {
        "type": "press",
        "target": "getByRole('textbox', { name: 'Type for hints...' })",
        "value": "ArrowLeft"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Type for hints...' })",
        "value": "{name}"
      }
    ]
  },
  "Verify Personal Details Header": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('link', { name: 'Contact Details' })"
      }
    ]
  },
  "Verify Login Error Message": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('menuitem', { name: 'Logout' })"
      },
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Username' })"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Username' })",
        "value": "salahsa"
      },
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Password' })"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Username' })",
        "value": "salahsal"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Password' })",
        "value": "ahsalah"
      },
      {
        "type": "press",
        "target": "getByRole('textbox', { name: 'Password' })",
        "value": "Enter"
      },
      {
        "type": "click",
        "target": "getByRole('button', { name: 'Login' })"
      }
    ]
  }
}