{
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "goto",
        "target": "{url}"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "fill",
        "target": "getByPlaceholder('Username')",
        "value": "{username}"
      }
    ]
  },
  "Input Password": {
    "steps": [
      {
        "type": "fill",
        "target": "getByPlaceholder('Password')",
        "value": "{password}"
      }
    ]
  },
  "Verify Dashboard": {
    "steps": [
      {
        "type": "toBeVisible",
        "target": "locator(\"div\").filter({ hasText: \"Time at WorkPunched\" }).nth(3)"
      }
    ]
  },
  "Verify Invalid Credentials Error": {
    "steps": [
      {
        "type": "toBeVisible",
        "target": "getByText(\"Invalid credentials\")"
      },
      {
        "type": "toBeVisible",
        "target": "getByText(\"Password\", { exact: true })"
      },
      {
        "type": "toBeVisible",
        "target": "getByText(\"Username\", { exact: true })"
      }
    ]
  },
  "Verify Required Validation": {
    "steps": [
      {
        "type": "toBeVisible",
        "target": "getByText(\"Required\").first()"
      },
      {
        "type": "toBeVisible",
        "target": "getByText(\"Required\").nth(1)"
      }
    ]
  }
}