{
  "Navigate to YouTube": {
    "steps": [
      {
        "type": "goto",
        "target": "https://www.youtube.com/"
      }
    ]
  },
  "Input search term": {
    "steps": [
      {
        "type": "fill",
        "target": "input[name='search_query']",
        "value": "{{searchTerm}}"
      }
    ]
  },
  "Click search button": {
    "steps": [
      {
        "type": "click",
        "target": "button#search-icon-legacy"
      }
    ]
  },
  "Click filter button": {
    "steps": [
      {
        "type": "click",
        "target": "xpath=//yt-formatted-string[contains(text(),'Filters')]"
      }
    ]
  },
  "Select This Week": {
    "steps": [
      {
        "type": "click",
        "target": "xpath=//yt-formatted-string[contains(text(),'This week')]"
      }
    ]
  },
  "Select first video result": {
    "steps": [
      {
        "type": "click",
        "target": "xpath=(//a[@id='video-title'])[1]"
      }
    ]
  },
  "Input invalid search term": {
    "steps": [
      {
        "type": "fill",
        "target": "input[name='search_query']",
        "value": "{{searchTerm}}"
      }
    ]
  },
  "Select Playlist type": {
    "steps": [
      {
        "type": "click",
        "target": "xpath=//yt-formatted-string[contains(text(),'Playlist')]"
      }
    ]
  },
  "Click profile/menu": {
    "steps": [
      {
        "type": "click",
        "target": "button#avatar-btn"
      }
    ]
  },
  "Click appearance": {
    "steps": [
      {
        "type": "click",
        "target": "xpath=//*[contains(text(),'Appearance')]"
      }
    ]
  },
  "Select Dark theme": {
    "steps": [
      {
        "type": "click",
        "target": "xpath=//*[contains(text(),'Dark theme')]"
      }
    ]
  },
  "Click like button": {
    "steps": [
      {
        "type": "click",
        "target": "xpath=(//button[@aria-label='like this video'])[1]"
      }
    ]
  },
  "Click subscribe button": {
    "steps": [
      {
        "type": "click",
        "target": "xpath=(//button[contains(@aria-label,'Subscribe')])[1]"
      }
    ]
  }
}
