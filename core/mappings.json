{
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "goto",
        "target": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "fill",
        "target": "getByPlaceholder(\"Username\")",
        "value": "{username}"
      }
    ]
  },
  "Input Password": {
    "steps": [
      {
        "type": "fill",
        "target": "getByPlaceholder(\"Password\")",
        "value": "{password}"
      }
    ]
  },
  "Click Login Button": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole(\"button\", \"name\")"
      }
    ]
  },
  "Verify Dashboard": {
    "steps": []
  }
}