{
  "Navigate to OrangeHRM": {
    "steps": [
      {
        "type": "goto",
        "target": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"
      },
      {
        "type": "verifyVisible",
        "target": "getByText('Username : AdminPassword :')"
      },
      {
        "type": "verifyVisible",
        "target": "getByRole('textbox', { name: 'Username' })"
      },
      {
        "type": "verifyVisible",
        "target": "getByRole('textbox', { name: 'Password' })"
      },
      {
        "type": "verifyText",
        "target": "getByRole('heading')",
        "value": "Login"
      }
    ]
  },
  "Input Username": {
    "steps": [
      {
        "type": "click",
        "target": "getByRole('textbox', { name: 'Username' })"
      },
      {
        "type": "fill",
        "target": "getByRole('textbox', { name: 'Username' })",
        "value": "Admin"
      }
    ]
  },
  "Input Password": {
    "steps": [
      {
        "type": "click",
        "target": "form.oxd-form > div.oxd-form-row > div.oxd-input-group.oxd-input-field-bottom-space > div > input.oxd-input.oxd-input--active"
      },
      {
        "type": "fill",
        "target": "form.oxd-form > div.oxd-form-row > div.oxd-input-group.oxd-input-field-bottom-space > div > input.oxd-input.oxd-input--focus",
        "value": "Admin"
      },
      {
        "type": "click",
        "target": "form.oxd-form > div.oxd-form-row > div.oxd-input-group.oxd-input-field-bottom-space > div > input.oxd-input.oxd-input--focus"
      },
      {
        "type": "fill",
        "target": "form.oxd-form > div.oxd-form-row > div.oxd-input-group.oxd-input-field-bottom-space > div > input.oxd-input.oxd-input--focus",
        "value": "admin123"
      },
      {
        "type": "click",
        "target": "html > x-pw-glass"
      },
      {
        "type": "click",
        "target": "div.orangehrm-login-slot > div.orangehrm-login-form > form.oxd-form > div.oxd-form-row > div.oxd-input-group.oxd-input-field-bottom-space"
      }
    ]
  }
}