    "steps": [
      {
        "type": "upload",
        "target": "input#file-input",
        "value": "multi_sheet.xlsx"
      }
    ]
  },
  "Drag File Over Zone": {
    "steps": [
      {
        "type": "click",
        "target": "div#drop-zone"
      }
    ]
  },
  "Trigger Info Status": {
    "steps": [
      {
        "type": "click",
        "target": "div#drop-zone"
      }
    ]
  },
  "Run Step for Hidden Element": {
    "steps": [
      {
        "type": "click",
        "target": "button.btn-danger"
      }
    ]
  },
  "Perform Multi-Step Action": {
    "steps": [
      {
        "type": "click",
        "target": "body"
      },
      {
        "type": "click",
        "target": "body"
      }
    ]
  },
  "Run Long Goto Step": {
    "steps": [
      {
        "type": "goto",
        "target": "http://localhost:3000"
      }
    ]
  },
