{
  "Login": {
    "version": "1.0",
    "steps": [
      { "type": "fill", "target": "#login_username", "value": "{{creds.username}}" },
      { "type": "fill", "target": "#mui-3", "value": "{{creds.password}}" },
      { "type": "click", "target": "button[name='Login']" }
    ]
  },
  "Create_New_Data": {
    "version": "1.0",
    "steps": [
      { "type": "click", "target": "text='Master Data/Aksesoris'" },
      { "type": "fill", "target": "#data_input", "value": "{{Excel.Data_Input_Column}}" },
      { "type": "click", "target": "button[name='Save']" }
    ]
  }
}
