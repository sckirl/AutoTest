{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "start": "node start.js",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node tests/run_all.js",
    "fixtures:serve": "node tests/fixtures/serve.js"
  },
  "build": {
    "appId": "com.autotest.studio",
    "productName": "AutoTest Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "studio/**/*",
      "core/**/*",
      "package.json",
      "playwright.config.ts",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "sign": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sckirl/AutoTest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sckirl/AutoTest/issues"
  },
  "homepage": "https://github.com/sckirl/AutoTest#readme",
  "dependencies": {
    "@playwright/test": "^1.61.0",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "approve": "^0.0.12",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "geckodriver": "^6.1.1",
    "multer": "^2.1.1",
    "scripts": "^0.1.0",
    "webdriverio": "^9.32.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "geckodriver@4.2.1": true,
    "edgedriver@6.3.1": true
  }
}
